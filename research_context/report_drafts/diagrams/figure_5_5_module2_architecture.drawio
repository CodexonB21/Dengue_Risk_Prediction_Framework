          <mxGeometry x="650" y="295" width="130" height="60" as="geometry" />
        </mxCell>

        <mxCell id="m2_label" value="Fold-aware epidemic-threshold labelling&#xa;outbreak = 1 if cases &gt; historical_mean + k × historical_SD&#xa;(strictly prior years only · harmonic seasonal estimator · k = 3.0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9D5FF;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="400" width="460" height="75" as="geometry" />
        </mxCell>

        <mxCell id="m2_feat" value="Stage 1 feature construction&#xa;Case history · climate lags · current-week climate · fold-aware anomalies&#xa;Seasonality / monsoon · case-anomaly lags · District (pooled model)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=12;" vertex="1" parent="1">
