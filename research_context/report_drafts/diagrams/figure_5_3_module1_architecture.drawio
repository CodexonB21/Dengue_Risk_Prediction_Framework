        </mxCell>

        <!-- STAGE 2 -->
        <mxCell id="s2_model" value="&lt;b&gt;XGBoost&lt;/b&gt;&lt;br&gt;Pooled residual learner&lt;br&gt;(predicts residual, not cases)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=12;align=center;" vertex="1" parent="1">
