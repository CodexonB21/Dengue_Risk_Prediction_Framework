        </mxCell>

        <mxCell id="s1_resid" value="&lt;b&gt;Residuals&lt;/b&gt;&lt;br&gt;Actual − Ŷ&lt;sub&gt;SARIMA&lt;/sub&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Out-of-sample residuals only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=12;align=center;" vertex="1" parent="1">
