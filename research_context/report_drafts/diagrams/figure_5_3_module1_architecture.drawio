        <mxCell id="s2_delta" value="&lt;b&gt;Residual Correction&lt;/b&gt;&lt;br&gt;Δ̂ per week" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=12;align=center;" vertex="1" parent="1">
