        <!-- INPUTS -->
        <mxCell id="in_cases" value="&lt;b&gt;Weekly Dengue Cases&lt;/b&gt;&lt;br&gt;District-week counts&lt;br&gt;(25 districts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#86EFAC;strokeColor=#15803D;fontColor=#14532D;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="45" y="115" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="in_climate" value="&lt;b&gt;Climate Features&lt;/b&gt;&lt;br&gt;Rainfall / temperature lags&lt;br&gt;Climate anomalies · monsoon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFDBFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="45" y="195" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="in_spatial" value="&lt;b&gt;Spatial Covariates&lt;/b&gt;&lt;br&gt;Elevation · population density&lt;br&gt;District centroids (GADM L1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFDBFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="45" y="280" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="in_pre" value="&lt;b&gt;Module 3 Preprocessing&lt;/b&gt;&lt;br&gt;Master table · epi-week climate&lt;br&gt;GADM Level-1 boundaries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;fontColor=#312E81;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="45" y="365" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="in_src" value="&lt;b&gt;Data Sources&lt;/b&gt;&lt;br&gt;Epidemiology Unit, MoH&lt;br&gt;Open-Meteo · Census · GADM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;fontColor=#374151;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="45" y="455" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="in_note" value="District-level only&lt;br&gt;(not DS-division)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;fontSize=10;size=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="545" width="190" height="50" as="geometry" />
        </mxCell>

        <!-- STAGE 1 -->
        <mxCell id="s1_kde" value="&lt;b&gt;KDE Baseline&lt;/b&gt;&lt;br&gt;Gaussian kernel over centroids&lt;br&gt;(case-weighted · Silverman bw)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="325" y="130" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s1_moran" value="&lt;b&gt;Moran’s I Check&lt;/b&gt;&lt;br&gt;Global clustering validation&lt;br&gt;(queen contiguity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="325" y="240" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s1_base" value="&lt;b&gt;KDE_baseline&lt;/b&gt;&lt;br&gt;Per district-week&lt;br&gt;spatial risk surface" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#4B5563;fontColor=#111827;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="325" y="350" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s1_note" value="Raw form → Moran’s I&lt;br&gt;Rescaled form → Stage 2" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=10;size=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="340" y="450" width="190" height="50" as="geometry" />
        </mxCell>

        <!-- STAGE 2 -->
        <mxCell id="s2_rf" value="&lt;b&gt;Random Forest&lt;/b&gt;&lt;br&gt;Spatial residual learner&lt;br&gt;(own-district lags primary; env. + demographic secondary)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="610" y="130" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2_resid" value="&lt;b&gt;Relative Residual&lt;/b&gt;&lt;br&gt;(Actual − Current_Risk) / (Current_Risk+1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FECACA;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="610" y="240" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s2_loop" value="&lt;b&gt;Iterative Update&lt;/b&gt;&lt;br&gt;Risk&lt;sub&gt;t&lt;/sub&gt; = Risk&lt;sub&gt;t−1&lt;/sub&gt; + α · Δ̂ · (Risk&lt;sub&gt;t−1&lt;/sub&gt;+1)&lt;br&gt;(α = 1, relative residual Δ̂)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#4B5563;fontColor=#111827;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="610" y="335" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2_note" value="Stop when risk change&lt;br&gt;&amp; residual Moran’s I converge" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=10;size=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="625" y="440" width="190" height="50" as="geometry" />
        </mxCell>

        <!-- OUTPUT -->
        <mxCell id="out_map" value="&lt;b&gt;Hybrid Hotspot / Risk Map&lt;/b&gt;&lt;br&gt;Converged district-week&lt;br&gt;spatial risk surface" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#86EFAC;strokeColor=#15803D;fontColor=#14532D;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="895" y="150" width="220" height="75" as="geometry" />
        </mxCell>
        <mxCell id="out_eval" value="&lt;b&gt;Evaluation&lt;/b&gt;&lt;br&gt;Moran’s I · spatial CV&lt;br&gt;MAE / RMSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;fontColor=#374151;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="895" y="280" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="out_idw" value="IDW continuous surface&lt;br&gt;(visualization only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#9CA3AF;fontColor=#374151;fontSize=10;align=center;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="895" y="400" width="220" height="50" as="geometry" />
        </mxCell>

