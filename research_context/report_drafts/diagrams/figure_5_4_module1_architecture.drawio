<mxfile host="app.diagrams.net" agent="Codexon FYP" version="22.1.0" type="device">
  <diagram id="module1-architecture" name="Figure 5.4 Module 1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Figure 5.4: High-level architecture of Module 1&#xa;Hybrid Time-Series Case Forecasting" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=16;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="560" height="50" as="geometry" />
        </mxCell>

        <mxCell id="m1_in_cases" value="Weekly dengue case counts&#xa;(district-level, MoH epi-weeks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontSize=12;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="m1_in_climate" value="Open-Meteo weekly climate&#xa;(precipitation, temperature, humidity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="90" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="m1_shared" value="Shared cleaned tables&#xa;Kalmunai→Ampara merge · epi-week calendar · climate weekly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#4B5563;fontColor=#111827;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="190" width="400" height="60" as="geometry" />
        </mxCell>

        <mxCell id="m1_pre" value="Module 1 preprocessing&#xa;Week-53 → week-52 merge · seasonal-naive gap fill · is_imputed flag&#xa;(imputed rows excluded from evaluation targets)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="290" width="400" height="70" as="geometry" />
        </mxCell>

        <mxCell id="m1_s1" value="Stage 1: Per-district SARIMA baseline&#xa;Input: weekly case counts only&#xa;Climate excluded by design" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFDBFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="400" width="400" height="70" as="geometry" />
        </mxCell>

        <mxCell id="m1_no_climate" value="No climate&#xa;into Stage 1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;fontSize=11;size=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="640" y="405" width="110" height="60" as="geometry" />
        </mxCell>

        <mxCell id="m1_resid" value="Residual extraction&#xa;residual = actual_cases − sarima_prediction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE68A;strokeColor=#B45309;fontColor=#78350F;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="510" width="400" height="60" as="geometry" />
        </mxCell>

        <mxCell id="m1_feat" value="Stage 2 feature construction&#xa;Case lags / rolling stats · climate lags &amp; fold-aware anomalies&#xa;Seasonality / monsoon · sarima_prediction · residual lags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="610" width="400" height="75" as="geometry" />
        </mxCell>

        <mxCell id="m1_climate_note" value="Climate enters&#xa;here only" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontSize=11;size=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="640" y="618" width="110" height="55" as="geometry" />
        </mxCell>

        <mxCell id="m1_s2" value="Stage 2: Pooled XGBoost residual regressor&#xa;Predicts Stage 1 residual (not raw case count)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCD34D;strokeColor=#B45309;fontColor=#78350F;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="725" width="400" height="60" as="geometry" />
        </mxCell>

        <mxCell id="m1_final" value="Final compensated forecast&#xa;final_prediction = sarima_prediction + predicted_residual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBF7D0;strokeColor=#15803D;fontColor=#14532D;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="825" width="400" height="60" as="geometry" />
        </mxCell>

        <mxCell id="m1_out" value="Outputs&#xa;District-week case forecast · residual series · walk-forward / holdout metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="925" width="400" height="60" as="geometry" />
        </mxCell>

        <mxCell id="m1_val" value="Validation design: expanding-window walk-forward by year + untouched 2-year holdout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#6B7280;fontColor=#374151;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="1025" width="480" height="40" as="geometry" />
